{
  "name": "alphaus-msp-simulator-nextjs",
  "version": "2.0.0",
  "description": "Alphaus MSP Revenue Simulator - Next.js Edition with Cloudflare Integration",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf:build": "next build && npx @cloudflare/next-on-pages",
    "cf:preview": "npm run cf:build && wrangler pages dev .vercel/output/static",
    "cf:deploy": "npm run cf:build && wrangler pages deploy .vercel/output/static --project-name=alphaus-msp-simulator"
  },
  "dependencies": {
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-chartjs-2": "^5.2.0",
    "chart.js": "^4.4.1",
    "uuid": "^10.0.0",
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "wrangler": "^3.80.0"
  }
}
